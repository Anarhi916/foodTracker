<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer rules for Android 12+ (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Encrypted tokens are undecryptable without the AndroidKeyStore master key
             (not backed up) → exclude to avoid a decrypt crash on restore. -->
        <exclude domain="sharedpref" path="nt_auth_tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nt_auth_tokens.xml" />
    </device-transfer>
</data-extraction-rules>
